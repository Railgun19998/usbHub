<Window x:Class="UsbHub.App.TrayBatteryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="usbHub 设备电量" Width="300" MaxHeight="420" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent" Foreground="#0A2B28">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="TraySeparator" Color="#30A4CEC5" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" /></Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="4,7" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  </Window.Resources>
  <Border x:Name="Frame" CornerRadius="14" BorderThickness="1">
    <Grid>
      <Border x:Name="Highlights" CornerRadius="14" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1.2" RadiusY="1"><GradientStop Color="#80FFFFFF" /><GradientStop Color="#0012C2A8" Offset="1" /></RadialGradientBrush></Border.Background></Border>
      <Grid Margin="10,10,10,8">
        <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource TraySeparator}" BorderThickness="0,0,0,1" Margin="0,0,0,3"><Grid Margin="4,0,4,5"><TextBlock FontSize="15" VerticalAlignment="Center"><Run Text="usb" FontWeight="Bold" /><Run Text="Hub" Foreground="#89A3A0" /></TextBlock><TextBlock Text="设备电量" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
        <ScrollViewer x:Name="TrayScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="EmptyLabel" Text="正在读取设备电量…" FontSize="11" Margin="4,14" />
            <ItemsControl x:Name="DeviceList"><ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{DynamicResource TraySeparator}" BorderThickness="0,0,0,1" Padding="3,6">
                <Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                  <Image Source="{Binding TrayTypeImage}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding TransportLabel}" FontSize="9" Opacity="0.55" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding TrayBatteryText}" FontWeight="SemiBold" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Color}" /><Setter Property="FontSize" Value="15" /><Style.Triggers><DataTrigger Binding="{Binding IsBatteryUnknown}" Value="True"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Normal" /></DataTrigger><DataTrigger Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding TrayState}" FontSize="8" Opacity="0.55" HorizontalAlignment="Right" Margin="0,1,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding TrayState}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <UniformGrid x:Name="TrayActions" Grid.Row="2" Columns="3" Margin="0,6,0,0"><Button x:Name="OpenButton" Content="打开主窗口" Click="Open_Click" /><Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click" /><Button x:Name="ExitButton" Content="退出" Click="Exit_Click" /></UniformGrid>
      </Grid>
    </Grid>
  </Border>
</Window>
