<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UsbHub.ico</ApplicationIcon>
    <AssemblyName>CHUB</AssemblyName>
    <AssemblyTitle>CHUB</AssemblyTitle>
    <Product>CHUB</Product>
    <RootNamespace>UsbHub.App</RootNamespace>
    <Description>CHUB Windows wireless device battery monitor</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableUiTests)' == 'true' and Exists('../../tests/UsbHub.UiTests/MainWindow.Preview.cs')">
    <DefineConstants>$(DefineConstants);CHUB_UI_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableUiTests)' == 'true' and Exists('../../tests/UsbHub.UiTests/MainWindow.Preview.cs')">
    <Compile Include="../../tests/UsbHub.UiTests/*.cs" Link="PrivateChecks/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UsbHub.Core\UsbHub.Core.csproj" />
    <Resource Include="Assets\UsbHub.ico" />
  </ItemGroup>
</Project>
