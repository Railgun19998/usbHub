<Window x:Class="UsbHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:UsbHub.App.Controls"
  Title="CHUB · 设备总览" Width="1440" Height="900" MinWidth="1100" MinHeight="720" Background="Transparent" WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="Assets/UsbHub.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="66" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowBorder" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStroke}" ClipToBounds="True">
    <Grid>
      <controls:GlassAtmosphere x:Name="Atmosphere" />
      <Grid Margin="16,14,20,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource GlassPanel}" Background="#B8FFFFFF" CornerRadius="28" Padding="14,22,14,18" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,30" VerticalAlignment="Center"><Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentGradient}" Margin="0,0,12,0"><TextBlock Text="◈" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock FontSize="22" VerticalAlignment="Center"><Run Text="C" FontWeight="Bold" /><Run Text="HUB" Foreground="#89A3A0" /></TextBlock></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="工作空间" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="14,0,0,8" /><Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Tag="overview" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="设备总览" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel></Button><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="提醒与设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel></Button></StackPanel>
            <StackPanel Grid.Row="2" Margin="12,0"><DockPanel Margin="0,0,0,15"><Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,9,0" /><TextBlock Text="休眠友好监测" FontSize="11" Foreground="{DynamicResource TextSecondary}" /><TextBlock Text="30 分钟" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" /></DockPanel><Border Height="1" Background="#B9DFD9" Margin="0,0,0,14" /><TextBlock x:Name="VersionLabel" FontSize="10" Foreground="{DynamicResource TextSecondary}" /></StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
          <Grid Margin="7,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="工作空间" Foreground="{DynamicResource TextSecondary}" /><TextBlock Text="·" Margin="10,0" Foreground="{DynamicResource TextSecondary}" /><TextBlock x:Name="PageTitle" Text="设备总览" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="34" Height="34" Padding="0" Margin="0,0,7,0" Click="Minimize_Click" AutomationProperties.Name="最小化" /><Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="34" Height="34" Padding="0" Margin="0,0,7,0" Click="Maximize_Click" AutomationProperties.Name="最大化或还原" /><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="34" Height="34" Padding="0" Click="Close_Click" AutomationProperties.Name="关闭窗口" /></StackPanel></Grid>
          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="#D9FFF4DF" BorderBrush="#80E9C78C" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,0,0,10" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Notice}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" Foreground="#996018" FontSize="11" /></Border>
            <Border Style="{StaticResource GlassPanel}" Padding="10,8" Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" CornerRadius="15" Background="#607EACA4" Padding="4"><StackPanel Orientation="Horizontal"><RadioButton Content="全部设备" GroupName="Connection" Tag="all" IsChecked="True" Checked="Filter_Checked" /><RadioButton Content="蓝牙" GroupName="Connection" Tag="bluetooth" Checked="Filter_Checked" /><RadioButton Content="USB / HID" GroupName="Connection" Tag="usb" Checked="Filter_Checked" /><RadioButton Content="低电量" GroupName="Connection" Tag="low" Checked="Filter_Checked" /></StackPanel></Border><Grid Grid.Column="1" Margin="8,3,0,3"><TextBox x:Name="DeviceSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索设备名称或制造商" AutomationProperties.Name="搜索设备名称或制造商" /><TextBlock Text="⌕   搜索设备" Foreground="{DynamicResource TextSecondary}" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DeviceSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Border>
          </StackPanel>
          <Grid Grid.Row="2" Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}" Margin="-6,0,-6,0">
            <Border Style="{StaticResource GlassPanel}" Margin="6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyTitle}" FontSize="21" Margin="0,20,0,10" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="430" /></StackPanel></Border>
            <ItemsControl x:Name="DeviceCards" ItemsSource="{Binding PageDevices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
              <controls:GlassCard Style="{StaticResource GlassPanel}" Margin="6" Padding="16,15,16,14" ToolTip="{Binding Detail}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" MinHeight="74" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="65" /><RowDefinition Height="16" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                  <DockPanel><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondary}" Margin="0,0,7,0" FontSize="10" VerticalAlignment="Center" /><TextBlock Text="{Binding TransportLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" /><Border Background="#20E79634" BorderBrush="#60E79634" BorderThickness="1" CornerRadius="9" Padding="7,1" HorizontalAlignment="Right" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolVisibility}}"><TextBlock Text="低" FontSize="10" Foreground="#BC7218" /></Border></DockPanel>
                  <controls:DeviceIllustration Grid.Row="1" Kind="{Binding Kind}" MaxHeight="145" Margin="0,3,0,7" />
                  <TextBlock Grid.Row="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,3" />
                  <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding BatteryText}" FontSize="44" FontWeight="Light" Foreground="{Binding Color}" /><TextBlock Text="{Binding BatteryUnit}" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,11" /></StackPanel>
                  <controls:BatteryBar Grid.Row="5" Percent="{Binding BatteryPercent}" Fill="{Binding BarColor}" Height="5" VerticalAlignment="Top" Visibility="{Binding ShowBar, Converter={StaticResource BoolVisibility}}" /><Border Grid.Row="5" Background="#BDD7D1" Height="1" VerticalAlignment="Center" Visibility="{Binding IsBatteryUnknown, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Grid.Row="6" Text="{Binding Source}" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                </Grid>
              </controls:GlassCard>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Grid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="6,8,6,16">
            <TextBlock Text="提醒与设置" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,10" /><TextBlock Text="设置适合你的提醒节奏。更改后点击保存，即刻生效。" Style="{StaticResource Muted}" Margin="0,0,0,28" />
            <Border Style="{StaticResource GlassPanel}" Padding="25" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="低电量提醒" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="启用 Windows 系统通知" IsChecked="{Binding Notifications}" /><TextBlock Text="{Binding ThresholdDescription}" Foreground="{DynamicResource Accent}" Margin="0,15,0,8" />
              <Slider Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Threshold}" AutomationProperties.Name="低电量提醒阈值" Margin="0,5,0,15" />
              <TextBlock Text="仅对实时读取成功的设备提醒。相同设备每 4 小时最多提醒一次，充电或电量恢复后重置。通知遵循 Windows 勿扰设置。" Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel></Border>
            <Border Style="{StaticResource GlassPanel}" Padding="25" Margin="0,0,0,18"><StackPanel><TextBlock Text="运行与外观" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="关闭窗口时继续在系统托盘运行" IsChecked="{Binding CloseToTray}" /><CheckBox Content="开启玻璃材质与柔和光晕" IsChecked="{Binding GlassEnabled}" /><TextBlock Text="主动查询间隔：30 分钟（全部设备）" Foreground="{DynamicResource Accent}" Margin="0,15,0,8" /><TextBlock Text="手动刷新、设备插拔和系统恢复均遵守同一间隔；期间显示上次结果，避免频繁打扰设备休眠。退出托盘程序后停止监控。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Border>
            <StackPanel Orientation="Horizontal"><Button Content="保存设置" Style="{StaticResource AccentButton}" Click="SaveSettings_Click" Margin="0,0,12,0" /><Button Content="发送测试通知" Click="TestNotification_Click" /></StackPanel>
          </StackPanel></ScrollViewer>

          <Grid Grid.Row="3" Margin="6,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ProtectionSummary}" FontSize="9" Foreground="{DynamicResource TextSecondary}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolVisibility}}"><Button Content="‹" Padding="10,3" Click="PreviousPage_Click" IsEnabled="{Binding CanPreviousPage}" AutomationProperties.Name="上一页设备" /><TextBlock Text="{Binding PageLabel}" Margin="10,0" VerticalAlignment="Center" FontSize="11" /><Button Content="›" Padding="10,3" Click="NextPage_Click" IsEnabled="{Binding CanNextPage}" AutomationProperties.Name="下一页设备" /></StackPanel><Button Grid.Column="2" Content="{Binding RefreshLabel}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" Padding="13,6" FontSize="11" /></Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
